generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  name String
  username String @unique
  password String
  bio String?

  email String @unique
  avatar String?
  role Role @default(USER)

  payments Payment[]
  cartItems CartItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum Role{
  USER
  ADMIN
  SELLER
}



model Section{
  id Int @id @default(autoincrement())
  name String
  Slug String @unique

  productCards ProductCard[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCard{
  id Int @id @default(autoincrement())

  name String
  description String?
  thumbnail String
  price Decimal @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  brand String?
  categories String[] @default([])
  slug String? @unique
  stock Int @default(0)
  badge String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectionId Int?
  section Section? @relation(fields:[sectionId], references:[id])

  orders Order[]
  cartItems CartItem[]
  wishlistItems WishlistItem[]

  @@index([createdAt])
  @@index([sectionId])
}

model CartItem {
  id Int @id @default(autoincrement())
  quantity Int @default(1)
  userId Int
  productId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ProductCard @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id Int @id @default(autoincrement())
  userId Int
  productId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ProductCard @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order{

  id Int @id @default(autoincrement())
  
  amount Int
  quantity Int
  productId Int
  productCard ProductCard @relation(fields:[productId],references:[id])

  paymentId Int
  payment Payment @relation(fields:[paymentId],references:[id])
 


  @@index([productId])
  @@index([paymentId])
}

model ProductInfo{

  id Int @id @default(autoincrement())
  userId Int?
  zoneId Int?
  email String?

  amount Int
  quantity Int
  
  paymentId Int
  payment Payment @relation(fields:[paymentId],references:[id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}


model Payment{
   
  id Int @id @default(autoincrement())
  isActive Boolean
  name String
  logo String?
  image String
  url String?
  
  userId Int
  user User @relation(fields:[userId],references:[id])

  orders Order[]
  productInfoes ProductInfo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}


model FeatureFlag{
   
   id Int @id @default(autoincrement())
   key String @unique
   enabled Boolean @default(false)
   
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}

model SlideShow{

  id Int @id @default(autoincrement())
  image String
  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Description{
   
   id Int @id @default(autoincrement())
   content String

   enabled Boolean @default(false)


}

model DescriptionCard{
  id Int @id @default(autoincrement())

  heading String
  content String
  image String?
  url  String?
  createdAt DateTime @default(now())
  updatedAt DateTime

}
